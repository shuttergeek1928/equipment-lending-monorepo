# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=equipmentdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass

# JWT (DEV) - replace in prod
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRY_SECONDS=3600

# .NET
DOTNET_ENV=Development

# Frontend
REACT_APP_AUTH_BASE=http://localhost:8081/api
REACT_APP_EQUIPMENT_BASE=http://localhost:8082/api
REACT_APP_BORROW_BASE=http://localhost:8083/api
REACT_APP_DASHBOARD_BASE=http://localhost:8084/api